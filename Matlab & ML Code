%% BASTION 
% AI-Assisted Predictive Energy Management for SMES

clc;
clear;
close all;

%% Generate Synthetic Demand Profile

t = 0:0.1:100;

load_profile = 50 ...
             + 20*sin(0.1*t) ...
             + 10*sin(0.5*t) ...
             + 5*randn(size(t));

%% Plot Demand Profile

figure;
plot(t, load_profile, 'LineWidth', 1.5);
xlabel('Time');
ylabel('Demand');
title('BASTION - Energy Demand Profile');
grid on;

%% Create Training Dataset

X = load_profile(1:end-1)';
Y = load_profile(2:end)';

%% Train Ensemble Regression Model

mdl = fitrensemble(X,Y);

%% Predict Demand

Y_pred = predict(mdl,X);

%% Plot Actual vs Predicted

figure;
plot(Y,'LineWidth',1.5);
hold on;
plot(Y_pred,'LineWidth',1.5);

xlabel('Sample Number');
ylabel('Demand');
title('BASTION - Ensemble Demand Prediction');

legend('Actual Demand','Predicted Demand');
grid on;

%% Error Metrics

MAE = mean(abs(Y - Y_pred));
RMSE = sqrt(mean((Y - Y_pred).^2));

fprintf('MAE  = %.4f\n',MAE);
fprintf('RMSE = %.4f\n',RMSE);

%% Save Model

save('bastion_model.mat','mdl');

disp('BASTION predictor saved successfully.');
